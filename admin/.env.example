# Leave EMPTY on Vercel and in development: /api is proxied (vercel.json / Vite) so cookies stay first-party.
# Only set this to an API origin that shares your app's registrable domain (e.g. app.example.com + api.example.com).
VITE_API_URL=

# Development only: where the Express API listens (default http://localhost:5000)
VITE_DEV_API_TARGET=http://localhost:5000
